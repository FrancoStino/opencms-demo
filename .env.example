# OpenCMS Docker Environment Configuration
# Copy this file to .env and customize the values

COMPOSE_PROJECT_NAME=opencms

# Database Configuration
DB_ROOT_PASSWORD=your_secure_root_password
DB_NAME=opencms
DB_USER=opencms
DB_PASSWORD=your_secure_opencms_password

# Java Configuration
JAVA_OPTS=-Xmx2g -Djava.awt.headless=true